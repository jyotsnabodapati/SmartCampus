# ============================================================
# SmartCampus RAG Knowledge Assistant - Environment Config
# ============================================================

# Groq Cloud API Key for LLM Inference (openai/gpt-oss-20b)
# Obtain your key at: https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key-here"

# Vector Database Storage Path (defaults to ./chroma_db)
CHROMA_DB_PATH="./chroma_db"

# Streamlit Port & Host Configuration (used in Docker)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS="0.0.0.0"

# Optional: Deployment Environment (development / staging / production)
ENVIRONMENT="development"
